[Unit]
Description=Redis Node on port 7001
After=network.target

[Service]
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/redis-7001.conf
ExecStop=/usr/bin/redis-cli -p 7001 shutdown
Restart=on-failure
RestartSec=3
StartLimitInterval=60
StartLimitBurst=3
LimitNOFILE=65535
Type=notify

# 固定 CPU
CPUAffinity=2

[Install]
WantedBy=multi-user.target