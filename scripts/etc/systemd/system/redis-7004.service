[Unit]
Description=Redis Node on port 7004
After=network.target

[Service]
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/redis-7004.conf
ExecStop=/usr/bin/redis-cli -p 7004 shutdown
Restart=on-failure
RestartSec=3
StartLimitInterval=60
StartLimitBurst=3
LimitNOFILE=65535
Type=notify

# 固定 CPU (防止redis.conf漏網的 thread 跑到別的 node 的 CPU)
CPUAffinity=8 9

# 禁用 Swap
MemorySwapMax=0

[Install]
WantedBy=multi-user.target